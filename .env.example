# ============================================================
# BACKEND  (copy to backend/.env)
# ============================================================

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT - use a 64-byte random hex string (openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_at_least_64_chars
JWT_EXPIRES_IN=7d

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Nodemailer / SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@unitygive.com
FROM_NAME="UnityGive Support"

# Web3 - Sepolia network
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_API_KEY>
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Private key of the wallet that deployed UnityGive.sol (admin wallet)
# NEVER commit a real private key!
ADMIN_PRIVATE_KEY=your_admin_wallet_private_key_without_0x_prefix


# ============================================================
# FRONTEND  (copy to frontend/.env)
# ============================================================

# Address of the deployed UnityGive.sol contract
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000

# Sepolia chain ID (11155111) or Hardhat local (31337)
VITE_CHAIN_ID=11155111

# Pinata IPFS credentials (for uploading Proof-of-Impact documents)
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_API_KEY=your_pinata_secret_api_key


# ============================================================
# SMART CONTRACTS  (copy to smart-contracts/.env)
# ============================================================

# Alchemy / Infura RPC endpoint for Sepolia testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_API_KEY>

# Deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_deployer_wallet_private_key_without_0x_prefix

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
