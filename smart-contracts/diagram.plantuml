@startuml
title UnityGive - Detailed Sequence Diagram\n(Multi-Sig + Milestone + Deadline + Excess + Top-up)

actor Admin
actor Donor
actor "Organization" as Org
actor "Council Member" as Council
participant "UnityGive Contract" as Contract

== 1. Register Campaign ==
Admin -> Contract: registerCampaign(mongoId, orgWallet, goalAmount, councilMembers, requiredVotes, milestoneAmounts, deadline) [onlyAdmin]
activate Contract
loop For each milestone
    Contract -> Contract: create Milestone(amount, ipfsEvidence="", approvalCount=0, isApproved=false, isFunded=false)
    Contract --> Admin: emit MilestoneAdded(milestoneIndex, amount)
end
Contract --> Admin: emit CampaignRegistered(campaignId, goalAmount, requiredVotes)
Contract --> Admin: return campaignId
deactivate Contract

== 2. Donation Flow (Excess Handling) ==
loop Multiple donations
    Donor -> Contract: donate(campaignId) {value: msg.value}
    activate Contract
    Contract -> Contract: check isActive && !expired
    alt currentAmount + msg.value > goalAmount (EXCESS)
        Contract -> Contract: excess = (currentAmount + msg.value) - goalAmount
        Contract -> Contract: added = msg.value - excess
        Contract -> Contract: currentAmount += added; donations[donor] += added
        Contract --> Org: transfer(excess) via low-level call {}
        note right: ✓ Excess sent immediately to organization
        Contract --> Donor: emit DonationReceived(campaignId, donor, added)
    else normal donation
        Contract -> Contract: currentAmount += msg.value; donations[donor] += msg.value
        Contract --> Donor: emit DonationReceived(campaignId, donor, msg.value)
    end
    deactivate Contract
end

== 3. Milestone Proof & Multi-Sig Approval ==
Org -> Contract: uploadProofOfImpact(campaignId, milestoneIndex, ipfsCID) [onlyOrganization]
activate Contract
Contract -> Contract: m.ipfsEvidence = ipfsCID; require(!m.isApproved)
Contract --> Org: emit ProofUploaded(campaignId, milestoneIndex, ipfsCID)
deactivate Contract

loop Multiple council votes (until threshold reached)
    Council -> Contract: voteApproveMilestone(campaignId, milestoneIndex) [onlyCouncilMember]
    activate Contract
    Contract -> Contract: verify: proof exists + !voted + !funded + !isApproved
    Contract -> Contract: hasVoted[...] = true; approvalCount++
    Contract --> Council: emit Voted(campaignId, milestoneIndex, voter)
   
    alt approvalCount >= requiredVotes (THRESHOLD REACHED)
        Contract -> Contract: m.isApproved = true
        Contract --> Contract: emit MilestoneApproved(campaignId, milestoneIndex)
       
        alt sufficient balance (currentAmount >= m.amount)
            Contract -> Contract: m.isFunded = true; currentAmount -= m.amount
            Contract --> Org: transfer(m.amount) via low-level call {}
            Contract --> Org: emit FundsReleased(campaignId, milestoneIndex, orgWallet, amount)
            note right: ✓ Funds released immediately
        else insufficient balance (PENDING)
            note right: ⏳ Milestone approved but isFunded=false\nWaiting for more donations or top-up
        end
    end
    deactivate Contract
end

== 4. After Deadline - Top-up ==
note over Contract #lightblue
  **When block.timestamp > deadline**
  Only callable if currentAmount < totalGoalAmount
end note

alt Goal NOT reached after deadline
    Org -> Contract: topUpCampaign(campaignId) {value: needed} [onlyOrganization]
    activate Contract
    Contract -> Contract: require(deadline passed && currentAmount < goalAmount)
    Contract -> Contract: needed = totalGoalAmount - currentAmount
    Contract -> Contract: require(msg.value >= needed)
    Contract -> Contract: excess = msg.value - needed
    Contract -> Contract: currentAmount = totalGoalAmount; isSuccessful = true
    Contract --> Org: emit DonationReceived(campaignId, Org, needed)
    alt excess > 0
        Contract --> Org: transfer(excess) via low-level call {}
    end
    deactivate Contract
else Goal already reached
    note right: ✓ No top-up needed\nmilestones proceed normally
end

== 5. Cancel Campaign & Refund ==
Admin -> Contract: cancelCampaign(campaignId) [onlyAdmin]
activate Contract
Contract -> Contract: require(isActive)
Contract -> Contract: isActive = false
Contract --> Admin: emit CampaignCancelled(campaignId)
deactivate Contract

loop Donors request refunds
    Donor -> Contract: refund(campaignId) [nonReentrant]
    activate Contract
    Contract -> Contract: require(!isActive); require(donations[donor] > 0)
    Contract -> Contract: amount = donations[Donor]; donations[Donor] = 0
    Contract -> Contract: currentAmount = max(0, currentAmount - amount)
    Contract --> Donor: transfer(amount) via low-level call {}
    Contract --> Donor: emit RefundIssued(campaignId, donor, amount)
    deactivate Contract
end
@enduml